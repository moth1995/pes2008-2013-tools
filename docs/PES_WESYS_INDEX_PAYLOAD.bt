// PES WESYS Indexed Payload - 010 Editor Binary Template
//
// This is the indexed payload WITHOUT the 0x10-byte WESYS wrapper.
//
// Seen:
//   * at full WESYS indexed container +0x10
//   * directly after inflating many WESYS zlib/deflated wrappers
//
// Layout:
//   +00 u32 numberOfEntries
//   +04 u32 ofsEntries       // observed 8
//   +08 WESYSFileEntry[]
//
// WESYSFileEntry:
//   u32 offset
//   u32 size
//   u32 nameOffset
//
// All offsets in this payload are relative to payload start.
//
// Corpus observations:
//   * ofsEntries == 8
//   * first child usually begins at align16(8 + numberOfEntries*12)
//   * child offsets are 0x10-aligned
//   * subsequent child offset usually equals align16(previous offset + size)
//   * nameOffset == 0xFFFFFFF0 means no name
//
// Terminology:
//   offset,size       = IDA kt_fs terminology
//   numberOfEntries  = IDA runtime vfsFileTable terminology
//   ofsEntries       = inferred from kt_fs serialized naming convention
//
// ---------------------------------------------------------------------------

LittleEndian();


// ---------------------------------------------------------------------------
// Shared helpers
// ---------------------------------------------------------------------------

int CStringSizeAt(int64 pos)
{
    local int64 oldPos = FTell();
    local int n = 0;
    local ubyte c;

    FSeek(pos);

    while (!FEof())
    {
        c = ReadUByte(FTell());
        FSeek(FTell() + 1);
        n++;

        if (c == 0)
            break;
    }

    FSeek(oldPos);
    return n;
}

typedef struct
{
    char value[CStringSizeAt(FTell())];
} CStringView;

// WESYS indexed record.
//
// offset/size terminology matches the kt_fs::FileBody / kt_fs::vfsFile
// terminology present in the PES 2008 IDA type dump.
//
// nameOffset is proven from PES samples, but that exact serialized field name
// is not present in the IDA dump.
typedef struct
{
    uint offset;
    uint size;
    uint nameOffset;
} WESYSFileEntry;


if (FileSize() < 8)
{
    Warning("File too small for WESYS indexed payload.");
    return;
}

local int64 payloadBase = 0;

uint numberOfEntries;
uint ofsEntries;

if (numberOfEntries > 1000000)
{
    Warning("Implausible numberOfEntries.");
    return;
}

if (ofsEntries != 8)
    Warning("Unexpected ofsEntries; known PES samples use 8.");

if (ofsEntries + numberOfEntries * 12 > FileSize())
{
    Warning("Entry table exceeds file size.");
    return;
}

FSeek(ofsEntries);

if (numberOfEntries > 0)
    WESYSFileEntry entries[numberOfEntries];

local int i;

for (i = 0; i < numberOfEntries; i++)
{
    local int64 childPos = payloadBase + entries[i].offset;

    if (entries[i].size > 0 &&
        childPos >= 0 &&
        childPos + entries[i].size <= FileSize())
    {
        FSeek(childPos);
        ubyte childData[entries[i].size];
    }

    if (entries[i].nameOffset != 0 &&
        entries[i].nameOffset != 0xFFFFFFF0)
    {
        local int64 namePos = payloadBase + entries[i].nameOffset;

        if (namePos >= 0 && namePos < FileSize())
        {
            FSeek(namePos);
            CStringView name;
        }
    }
}

FSeek(FileSize());
